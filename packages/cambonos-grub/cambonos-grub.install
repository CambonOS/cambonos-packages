post_install() {
  if ! /usr/lib/cambonos-grub/regenerate-grub-config; then
    printf 'cambonos-grub: GRUB configuration was not regenerated; run grub-mkconfig manually.\n' >&2
  fi
}

post_upgrade() {
  if ! /usr/lib/cambonos-grub/regenerate-grub-config; then
    printf 'cambonos-grub: GRUB configuration was not regenerated; run grub-mkconfig manually.\n' >&2
  fi
}

post_remove() {
  local grub_cfg=/boot/grub/grub.cfg
  if [[ ! -e "$grub_cfg" && ! -L "$grub_cfg" ]]; then
    return 0
  fi
  if [[ ! -f "$grub_cfg" || -L "$grub_cfg" ]]; then
    printf 'cambonos-grub: refusing to replace a non-regular %s.\n' "$grub_cfg" >&2
    return 0
  fi
  if ! /usr/bin/grub-mkconfig -o "$grub_cfg"; then
    printf 'cambonos-grub: GRUB configuration was not regenerated after removal.\n' >&2
  fi
}