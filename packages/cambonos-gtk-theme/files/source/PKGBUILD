# Maintainer: CambonOS contributors
pkgname=cambonos-gtk-theme
pkgver=0.4.0
pkgrel=1
pkgdesc="GTK 3/4 and Xfwm4 themes for CambonOS (light and dark)"
arch=('any')
license=('MIT')

package() {
    install -d "$pkgdir/usr/share/themes"

    cp -a "$startdir/themes/CambonOS" "$pkgdir/usr/share/themes/"
    cp -a "$startdir/themes/CambonOS-dark" "$pkgdir/usr/share/themes/"

    install -Dm644 "$startdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$startdir/docs/COMPATIBILITY.md" \
        "$pkgdir/usr/share/doc/$pkgname/COMPATIBILITY.md"
}
