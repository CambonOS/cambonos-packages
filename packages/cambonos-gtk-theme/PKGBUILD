pkgname=cambonos-gtk-theme
pkgver=0.2.0
pkgrel=2
pkgdesc="CambonOS dark GTK 2, GTK 3, GTK 4 and XFWM4 theme"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-or-later')

package() {
  local theme_dir="$pkgdir/usr/share/themes/CambonOS-Dark"

  install -Dm644 "$startdir/files/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/files/upstream/ORCHIS-NOTICE" \
    "$pkgdir/usr/share/doc/$pkgname/ORCHIS-NOTICE"

  install -d "$theme_dir"
  cp -a "$startdir/files/themes/CambonOS-Dark/." "$theme_dir/"
}
