# Maintainer: CambonOS contributors
pkgname=cambonos-gtk-theme
pkgver=0.8.0
pkgrel=1
pkgdesc="CambonOS GTK 3/4 and Xfwm4 dark themes with three transparency profiles"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-only')
makedepends=('python')
optdepends=(
  'gtk3: GTK 3 application styling'
  'gtk4: GTK 4 application styling'
  'xfwm4: Xfwm4 window decoration theme'
)

_themes=(
  CambonOS-dark-Conservative
  CambonOS-dark-Balanced
  CambonOS-dark-Transparent
)

build() {
  local builddir="$srcdir/$pkgname-$pkgver"

  rm -rf "$builddir"
  install -d "$builddir"
  cp -a "$startdir/files/." "$builddir/"

  # Generate all three themes from the one canonical palette/template and
  # validate the complete GTK3/GTK4 and Xfwm4 output before packaging.
  python "$builddir/tools/build-theme.py"
  python "$builddir/tools/validate-theme.py"
}

package() {
  local builddir="$srcdir/$pkgname-$pkgver"

  [[ -d "$startdir/files" ]] || return 1
  install -d "$pkgdir/usr/share/themes"
  for theme in "${_themes[@]}"; do
    [[ -d "$builddir/themes/$theme" ]] || {
      error "Generated theme is missing: $theme"
      return 1
    }
    cp -a "$builddir/themes/$theme" "$pkgdir/usr/share/themes/"
  done

  install -Dm644 "$builddir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
