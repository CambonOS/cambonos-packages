post_install() {
    /usr/lib/cambonos/restore-release-files
}

post_upgrade() {
    /usr/lib/cambonos/restore-release-files
}

post_remove() {
    # Restore Arch's standard os-release link only when ours is still active.
    if [[ -L /etc/os-release ]] &&
       [[ "$(readlink -- /etc/os-release)" == "../usr/lib/cambonos/os-release" ]]; then
        if ! ln -sfnT -- ../usr/lib/os-release /etc/os-release; then
            printf 'cambonos-release: could not restore /etc/os-release; preserving the current link.\n' >&2
        fi
    fi

    local state_dir="/var/lib/cambonos-release"
    local backup="$state_dir/lsb-release.original"
    local was_absent="$state_dir/lsb-release.was-absent"
    local managed="$state_dir/lsb-release.managed"
    local pacnew="/etc/lsb-release.pacnew"
    local temporary_dir=""

    # Nothing to recover when this package never managed the optional file.
    if [[ ! -d "$state_dir" || -L "$state_dir" ]]; then
        if [[ -e "$state_dir" || -L "$state_dir" ]]; then
            printf 'cambonos-release: %s is not a real directory; preserving it.\n' "$state_dir" >&2
        fi
        return 0
    fi

    # The managed snapshot is required to distinguish our file from an
    # administrator-owned replacement. Missing or invalid metadata is kept.
    if [[ ! -f "$managed" || -L "$managed" ]]; then
        printf 'cambonos-release: missing or invalid managed snapshot; keeping %s for manual recovery.\n' "$state_dir" >&2
        return 0
    fi

    if [[ ! -f /etc/lsb-release || -L /etc/lsb-release ]]; then
        printf 'cambonos-release: /etc/lsb-release is missing or is not a regular file; preserving recovery state.\n' >&2
        return 0
    fi

    if ! cmp -s -- /etc/lsb-release "$managed"; then
        printf 'cambonos-release: /etc/lsb-release was modified; preserving it and %s.\n' "$state_dir" >&2
        return 0
    fi

    # Exactly one original-state marker must exist. Reject ambiguous metadata.
    if [[ -e "$backup" || -L "$backup" ]]; then
        if [[ -d "$backup" && ! -L "$backup" ]]; then
            printf 'cambonos-release: invalid backup directory; keeping %s.\n' "$state_dir" >&2
            return 0
        fi
        if [[ -e "$was_absent" || -L "$was_absent" ]]; then
            printf 'cambonos-release: conflicting original-state markers; keeping %s.\n' "$state_dir" >&2
            return 0
        fi

        if [[ -e "$pacnew" || -L "$pacnew" ]]; then
            if [[ ! -f "$pacnew" || -L "$pacnew" ]]; then
                printf 'cambonos-release: %s is not a regular file; keeping %s.\n' "$pacnew" "$state_dir" >&2
                return 0
            fi
            if ! mv -fT -- "$pacnew" /etc/lsb-release; then
                printf 'cambonos-release: could not restore %s; keeping %s.\n' "$pacnew" "$state_dir" >&2
                return 0
            fi
        else
            # Stage the original on /etc's filesystem and atomically replace
            # the managed file. cp -a preserves the original metadata.
            temporary_dir="$(mktemp -d /etc/.lsb-release.restore.XXXXXX)" || {
                printf 'cambonos-release: could not create a temporary restore directory; keeping %s.\n' "$state_dir" >&2
                return 0
            }
            if ! cp -a -- "$backup" "$temporary_dir/lsb-release"; then
                rm -rf -- "$temporary_dir"
                printf 'cambonos-release: could not stage the original file; keeping %s.\n' "$state_dir" >&2
                return 0
            fi
            if ! mv -fT -- "$temporary_dir/lsb-release" /etc/lsb-release; then
                rm -rf -- "$temporary_dir"
                printf 'cambonos-release: could not install the original file; keeping %s.\n' "$state_dir" >&2
                return 0
            fi
            rmdir -- "$temporary_dir" 2>/dev/null || true
        fi
    elif [[ -f "$was_absent" && ! -L "$was_absent" ]]; then
        if [[ -e "$pacnew" || -L "$pacnew" ]]; then
            if [[ ! -f "$pacnew" || -L "$pacnew" ]]; then
                printf 'cambonos-release: %s is not a regular file; keeping %s.\n' "$pacnew" "$state_dir" >&2
                return 0
            fi
            if ! mv -fT -- "$pacnew" /etc/lsb-release; then
                printf 'cambonos-release: could not restore %s; keeping %s.\n' "$pacnew" "$state_dir" >&2
                return 0
            fi
        elif ! rm -f -- /etc/lsb-release; then
            printf 'cambonos-release: could not remove the managed file; keeping %s.\n' "$state_dir" >&2
            return 0
        fi
    else
        printf 'cambonos-release: original-state metadata is missing or invalid; keeping %s.\n' "$state_dir" >&2
        return 0
    fi

    # Remove recovery material only after a complete, verified restoration.
    if ! rm -rf -- "$state_dir"; then
        printf 'cambonos-release: restoration succeeded but could not clean %s; it was retained.\n' "$state_dir" >&2
    fi
}
