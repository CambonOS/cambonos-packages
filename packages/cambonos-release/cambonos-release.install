post_install() {
    /usr/lib/cambonos/restore-release-files
}

post_upgrade() {
    /usr/lib/cambonos/restore-release-files
}

post_remove() {
    # Restore Arch's standard os-release link only when ours is still active.
    if [[ -L /etc/os-release ]] &&
       [[ "$(readlink -- /etc/os-release)" == "../usr/lib/cambonos/os-release" ]]; then
        ln -sfnT -- ../usr/lib/os-release /etc/os-release
    fi

    # Restore the original lsb-release file only if it still contains the
    # CambonOS-managed content. Preserve administrator edits made afterwards.
    state_dir="/var/lib/cambonos-release"
    backup="$state_dir/lsb-release.original"
    was_absent="$state_dir/lsb-release.was-absent"
    managed="$state_dir/lsb-release.managed"
    pacnew="/etc/lsb-release.pacnew"

    restored=0
    temporary_dir=""

    # Restore only when the current file is still the exact version managed by
    # CambonOS. If an administrator changed it, keep both that file and the
    # recovery data so the original can still be recovered manually.
    if [[ -f "$managed" ]] &&
       [[ -f /etc/lsb-release && ! -L /etc/lsb-release ]] &&
       cmp -s -- /etc/lsb-release "$managed"; then
        if [[ -f "$pacnew" ]]; then
            # If pacman preserved a newer upstream default as .pacnew, prefer it.
            if mv -fT -- "$pacnew" /etc/lsb-release; then
                restored=1
            fi
        elif [[ -e "$backup" || -L "$backup" ]]; then
            # Restore through a temporary directory on /etc's filesystem so
            # the original metadata is retained and the replacement is atomic.
            temporary_dir="$(mktemp -d /etc/.lsb-release.restore.XXXXXX)" || temporary_dir=""
            if [[ -n "$temporary_dir" ]] &&
               cp -a -- "$backup" "$temporary_dir/restored" &&
               mv -fT -- "$temporary_dir/restored" /etc/lsb-release; then
                restored=1
            fi
            [[ -z "$temporary_dir" ]] || rmdir -- "$temporary_dir" 2>/dev/null || true
        elif [[ -e "$was_absent" ]]; then
            if rm -f -- /etc/lsb-release; then
                restored=1
            fi
        fi
    elif [[ ! -e /etc/lsb-release && ! -L /etc/lsb-release ]] &&
         [[ -e "$backup" || -L "$backup" ]]; then
        # The managed file may have been removed independently. The saved
        # original is still recoverable and must not be discarded.
        temporary_dir="$(mktemp -d /etc/.lsb-release.restore.XXXXXX)"
        if cp -a -- "$backup" "$temporary_dir/restored" &&
           mv -fT -- "$temporary_dir/restored" /etc/lsb-release; then
            restored=1
        fi
        rmdir -- "$temporary_dir" 2>/dev/null || true
    elif [[ ! -e /etc/lsb-release && ! -L /etc/lsb-release ]] &&
         [[ -e "$was_absent" ]]; then
        restored=1
    fi

    if (( restored )); then
        rm -rf -- "$state_dir"
    elif [[ -d "$state_dir" ]]; then
        printf 'cambonos-release: no se pudo restaurar %s de forma segura; se conserva %s para recuperación manual.\n' \
            /etc/lsb-release "$state_dir" >&2
    fi
}
