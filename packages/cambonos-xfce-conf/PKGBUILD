  'xfce4-appfinder'
  'xfce4-clipman-plugin'
  'xfce4-notifyd'
  'xfce4-panel'
  'xfce4-whiskermenu-plugin'
  'xfce4-power-manager'
  'xfce4-pulseaudio-plugin'
  'xfce4-screensaver'
  'xfce4-screenshooter'
  'xfce4-session'
  'xfce4-settings'
  'xfce4-taskmanager'
