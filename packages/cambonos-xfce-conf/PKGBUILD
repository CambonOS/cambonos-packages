pkgname=cambonos-xfce-conf
pkgver=0.1.0
pkgrel=2
pkgdesc="CambonOS XFCE session, system defaults and desktop customization"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-only')
backup=(
  'etc/cambonos/xdg/menus/xfce-applications.menu'
  'etc/cambonos/xdg/xfce-mimeapps.list'
  'etc/cambonos/xdg/xfce4/helpers.rc'
  'etc/cambonos/xdg/xfce4/panel/whiskermenu-1.rc'
  'etc/cambonos/xdg/xfce4/panel/launcher-10/17618130321.desktop'
  'etc/cambonos/xdg/xfce4/panel/launcher-11/17618130322.desktop'
  'etc/cambonos/xdg/xfce4/panel/launcher-12/17618130323.desktop'
  'etc/cambonos/xdg/xfce4/terminal/terminalrc'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/keyboards.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-notifyd.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-screensaver.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml'
  'etc/cambonos/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml'
)
makedepends=('cambonos-branding')
depends=(
  'cambonos-graphical-base'
  'cambonos-branding'
  'cambonos-gtk-theme'
  'cambonos-lightdm'
  'cantarell-fonts'
