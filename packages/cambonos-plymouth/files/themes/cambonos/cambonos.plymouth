[Plymouth Theme]
Name=CambonOS
Description=CambonOS branded boot splash with progress animation
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/cambonos
ScaleBackgroundImage=true
BackgroundStartColor=0x061C31
BackgroundEndColor=0x061C31
HorizontalAlignment=0.5
VerticalAlignment=0.66
ProgressBarHorizontalAlignment=0.5
ProgressBarVerticalAlignment=0.7
ProgressBarWidth=420
ProgressBarHeight=8
ProgressBarBackgroundColor=0x29465A
ProgressBarForegroundColor=0x70E7E6
Transition=none
TransitionDuration=0.0
MessageBelowAnimation=false
DialogClearsFirmwareBackground=true

[boot-up]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=false
UseEndAnimation=false

[shutdown]
UseAnimation=false
UseProgressBar=false
UseEndAnimation=false

[reboot]
UseAnimation=false
UseProgressBar=false
UseEndAnimation=false

[updates]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true

[system-upgrade]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true

[firmware-upgrade]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true

[system-reset]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true
