[Plymouth Theme]
Name=CambonOS
Description=CambonOS branded boot splash with progress animation
ModuleName=script

[script]
ImageDir=/usr/share/cambonos/branding
ScriptFile=/usr/share/plymouth/themes/cambonos/cambonos.script
ConsoleLogBackgroundColor=0x061C31

[boot-up]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=false
UseEndAnimation=false

[shutdown]
UseAnimation=false
UseProgressBar=false
UseEndAnimation=false

[reboot]
UseAnimation=false
UseProgressBar=false
UseEndAnimation=false

[updates]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true

[system-upgrade]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true

[firmware-upgrade]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true

[system-reset]
UseAnimation=false
UseProgressBar=true
ProgressBarShowPercentComplete=true
SuppressMessages=true
