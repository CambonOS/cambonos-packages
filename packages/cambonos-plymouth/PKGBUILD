pkgname=cambonos-plymouth
pkgver=0.1.0
pkgrel=1
pkgdesc="CambonOS Plymouth theme and mkinitcpio integration"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-only')
depends=('plymouth' 'mkinitcpio>=36')
backup=('etc/mkinitcpio.conf.d/90-cambonos-plymouth.conf')
install=cambonos-plymouth.install

package() {
  install -Dm644 "$startdir/files/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/files/mkinitcpio/90-cambonos-plymouth.conf" \
    "$pkgdir/etc/mkinitcpio.conf.d/90-cambonos-plymouth.conf"
  install -d "$pkgdir/usr/share/plymouth/themes/cambonos"
  cp -a \
    "$startdir/files/themes/cambonos/animation-0001.png" \
    "$startdir/files/themes/cambonos/box.png" \
    "$startdir/files/themes/cambonos/bullet.png" \
    "$startdir/files/themes/cambonos/cambonos.plymouth" \
    "$startdir/files/themes/cambonos/capslock.png" \
    "$startdir/files/themes/cambonos/entry.png" \
    "$startdir/files/themes/cambonos/header-image.png" \
    "$startdir/files/themes/cambonos/keyboard.png" \
    "$startdir/files/themes/cambonos/keymap-render.png" \
    "$startdir/files/themes/cambonos/lock.png" \
    "$startdir/files/themes/cambonos/throbber-0001.png" \
    "$startdir/files/themes/cambonos/throbber-0002.png" \
    "$startdir/files/themes/cambonos/throbber-0003.png" \
    "$startdir/files/themes/cambonos/throbber-0004.png" \
    "$startdir/files/themes/cambonos/throbber-0005.png" \
    "$startdir/files/themes/cambonos/throbber-0006.png" \
    "$startdir/files/themes/cambonos/throbber-0007.png" \
    "$startdir/files/themes/cambonos/throbber-0008.png" \
    "$startdir/files/themes/cambonos/throbber-0009.png" \
    "$startdir/files/themes/cambonos/throbber-0010.png" \
    "$startdir/files/themes/cambonos/throbber-0011.png" \
    "$startdir/files/themes/cambonos/throbber-0012.png" \
    "$startdir/files/themes/cambonos/throbber-0013.png" \
    "$startdir/files/themes/cambonos/throbber-0014.png" \
    "$startdir/files/themes/cambonos/throbber-0015.png" \
    "$startdir/files/themes/cambonos/throbber-0016.png" \
    "$startdir/files/themes/cambonos/throbber-0017.png" \
    "$startdir/files/themes/cambonos/throbber-0018.png" \
    "$startdir/files/themes/cambonos/throbber-0019.png" \
    "$startdir/files/themes/cambonos/throbber-0020.png" \
    "$startdir/files/themes/cambonos/throbber-0021.png" \
    "$startdir/files/themes/cambonos/throbber-0022.png" \
    "$startdir/files/themes/cambonos/throbber-0023.png" \
    "$startdir/files/themes/cambonos/throbber-0024.png" \
    "$startdir/files/themes/cambonos/throbber-0025.png" \
    "$startdir/files/themes/cambonos/throbber-0026.png" \
    "$startdir/files/themes/cambonos/throbber-0027.png" \
    "$startdir/files/themes/cambonos/throbber-0028.png" \
    "$startdir/files/themes/cambonos/throbber-0029.png" \
    "$startdir/files/themes/cambonos/throbber-0030.png" \
    "$pkgdir/usr/share/plymouth/themes/cambonos/"
