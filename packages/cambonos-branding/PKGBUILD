pkgname=cambonos-branding
pkgver=1.0.0
pkgrel=1
pkgdesc="CambonOS visual identity assets"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-only')
groups=('cambonos-base')
depends=('bash' 'coreutils' 'gawk' 'kbd')
install=cambonos-branding.install
backup=('etc/dialogrc')

package() {
  local branding_dir="$pkgdir/usr/share/cambonos/branding"
  local udev_rules_dir="$pkgdir/usr/lib/udev/rules.d"

  install -Dm644 "$startdir/files/dialogrc" \
    "$pkgdir/etc/dialogrc"

  # Canonical location: all original branding assets live here.
  install -Dm644 "$startdir/files/cambonos-icon.svg" \
    "$branding_dir/cambonos-icon.svg"
  install -Dm644 "$startdir/files/cambonos-text.svg" \
    "$branding_dir/cambonos-text.svg"
  install -Dm644 "$startdir/files/cambonos-icon.png" \
    "$branding_dir/cambonos-icon.png"
  install -Dm644 "$startdir/files/cambonos-text.png" \
    "$branding_dir/cambonos-text.png"
  install -Dm644 "$startdir/files/plymouth-background.png" \
    "$branding_dir/plymouth-background.png"
  base64 --decode "$startdir/files/progress-background.png.base64" \
    > "$branding_dir/progress-background.png"
  base64 --decode "$startdir/files/progress-foreground.png.base64" \
    > "$branding_dir/progress-foreground.png"
  install -Dm644 "$startdir/files/console-colors" \
    "$branding_dir/console-colors"
  install -Dm644 "$startdir/files/90-cambonos-console-colors.rules" \
    "$udev_rules_dir/90-cambonos-console-colors.rules"
  install -Dm644 "$startdir/files/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

}
