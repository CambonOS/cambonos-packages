pkgname=cambonos-branding
pkgver=0.1.0
pkgrel=9
pkgdesc="CambonOS visual identity assets"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-only')
depends=('fontconfig')

package() {
  local branding_dir="$pkgdir/usr/share/cambonos/branding"
  local icon_dir="$pkgdir/usr/share/icons/hicolor/scalable/apps"
  local pixmaps_dir="$pkgdir/usr/share/pixmaps"
  local font_dir="$pkgdir/usr/share/fonts/TTF"
  local fontconfig_avail="$pkgdir/usr/share/fontconfig/conf.avail"
  local fontconfig_default="$pkgdir/usr/share/fontconfig/conf.default"

  # Canonical location: all original branding assets live here.
  install -Dm644 "$startdir/files/cambonos-icon.svg" \
    "$branding_dir/cambonos-icon.svg"
  install -Dm644 "$startdir/files/cambonos-icon-black.svg" \
    "$branding_dir/cambonos-icon-black.svg"
  install -Dm644 "$startdir/files/cambonos-icon-white.svg" \
    "$branding_dir/cambonos-icon-white.svg"
  install -Dm644 "$startdir/files/cambonos-text.svg" \
    "$branding_dir/cambonos-text.svg"
  install -Dm644 "$startdir/files/cambonos-text-black.svg" \
    "$branding_dir/cambonos-text-black.svg"
  install -Dm644 "$startdir/files/cambonos-text-white.svg" \
    "$branding_dir/cambonos-text-white.svg"
  install -Dm644 "$startdir/files/cambonos-logo.txt" \
    "$branding_dir/cambonos-logo.txt"

  # Install the prebuilt symbol font as a static branding resource.
  install -Dm644 "$startdir/files/CambonOS-Symbols.ttf" \
    "$font_dir/CambonOS-Symbols.ttf"

  # Publish the private-use glyph fallback through Fontconfig defaults.
  install -Dm644 "$startdir/files/65-cambonos-symbols.conf" \
    "$fontconfig_avail/65-cambonos-symbols.conf"
  install -d "$fontconfig_default"
  ln -s ../conf.avail/65-cambonos-symbols.conf \
    "$fontconfig_default/65-cambonos-symbols.conf"

  install -Dm644 "$startdir/files/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Published integration paths used by desktop icon themes and consumers.
  install -d "$icon_dir" "$pixmaps_dir"
  ln -s ../../../../cambonos/branding/cambonos-icon.svg \
    "$icon_dir/cambonos-logo.svg"
  ln -s ../cambonos/branding/cambonos-icon.svg \
    "$pixmaps_dir/cambonos-logo.svg"
  ln -s ../cambonos/branding/cambonos-text.svg \
    "$pixmaps_dir/cambonos-logo-text.svg"
}
