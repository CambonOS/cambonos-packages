#!/usr/bin/bash
set -Eeuo pipefail

readonly CONFIG_DIR="/etc/xdg/xfce4/terminal"
readonly CONFIG_FILE="$CONFIG_DIR/terminalrc"
readonly STATE_DIR="/var/lib/cambonos-branding/xfce4-terminal"
readonly ORIGINAL_FILE="$STATE_DIR/terminalrc.original"
readonly ABSENT_MARKER="$STATE_DIR/terminalrc.was-absent"
readonly MANAGED_FILE="$STATE_DIR/terminalrc.managed"
readonly DEFAULTS_FILE="/usr/share/cambonos/branding/xfce-terminalrc"

usage() {
  printf 'Usage: %s [--sync|--remove]\n' "$0" >&2
  exit 2
}

action="${1:---sync}"
[[ $# -le 1 ]] || usage
case "$action" in
  --sync|--remove) ;;
  *) usage ;;
esac

report_error() {
  printf 'cambonos-branding: %s\n' "$1" >&2
}

validate_config_path() {
  if [[ -L "$CONFIG_DIR" ]]; then
    report_error "$CONFIG_DIR es un enlace simbólico; no se modificará."
    return 1
  fi
  if [[ -e "$CONFIG_DIR" && ! -d "$CONFIG_DIR" ]]; then
    report_error "$CONFIG_DIR no es un directorio; no se modificará."
    return 1
  fi
  if [[ -L "$CONFIG_FILE" ]]; then
    report_error "$CONFIG_FILE es un enlace simbólico; no se modificará."
    return 1
  fi
  if [[ -e "$CONFIG_FILE" && ! -f "$CONFIG_FILE" ]]; then
    report_error "$CONFIG_FILE no es un archivo regular; no se modificará."
    return 1
  fi
}

rewrite_config() {
  local mode="$1"
  local source="/dev/null"
  local original="/dev/null"
  local temporary

  [[ -f "$CONFIG_FILE" ]] && source="$CONFIG_FILE"
  [[ -f "$ORIGINAL_FILE" ]] && original="$ORIGINAL_FILE"
  temporary="$(mktemp "$CONFIG_DIR/.terminalrc.cambonos.XXXXXX")"

  if ! awk -v mode="$mode" -v template="$DEFAULTS_FILE" -v original="$original" '
    function parse_assignment(line,    value) {
      value = line
      sub(/^[ \t]*/, "", value)
      if (index(value, "=") == 0) return ""
      parsed_key = value
      sub(/[ \t]*=.*/, "", parsed_key)
      parsed_value = value
      sub(/^[^=]*=/, "", parsed_value)
      sub(/^[ \t]*/, "", parsed_value)
      sub(/[ \t]*$/, "", parsed_value)
      return parsed_key
    }
    function is_managed(key) {
      return key == "ColorUseTheme" || key == "ColorBackground" || \
             key == "ColorForeground" || key == "ColorPalette"
    }
    function load_ini(path, destination,    line, section, key) {
      section = ""
      while ((getline line < path) > 0) {
        if (line ~ /^[ \t]*\[/) {
          section = line
          sub(/^[ \t]*\[/, "", section)
          sub(/\][ \t]*(#.*)?$/, "", section)
          continue
        }
        if (section != "Configuration") continue
        key = parse_assignment(line)
        if (!is_managed(key)) continue
        if (destination == "desired") {
          if (desired_line[key] != "") malformed = 1
          desired_line[key] = line
          desired_value[key] = parsed_value
        } else {
          if (original_found[key]) malformed = 1
          original_found[key] = 1
          original_line[key] = line
        }
      }
      close(path)
    }
    function flush_missing(    key) {
      if (mode != "--sync") return
      for (key_index = 1; key_index <= 4; key_index++) {
        key = key_order[key_index]
        if (!current_found[key]) {
          print desired_line[key]
          current_found[key] = 1
        }
      }
    }
    BEGIN {
      key_order[1] = "ColorUseTheme"
      key_order[2] = "ColorBackground"
      key_order[3] = "ColorForeground"
      key_order[4] = "ColorPalette"
      load_ini(template, "desired")
      if (mode == "--remove") load_ini(original, "original")
      for (key_index = 1; key_index <= 4; key_index++) {
        if (desired_line[key_order[key_index]] == "") malformed = 1
      }
    }
    /^[ \t]*\[[^]]+\]/ {
      if (in_configuration) flush_missing()
      section = $0
      sub(/^[ \t]*\[/, "", section)
      sub(/\][ \t]*(#.*)?$/, "", section)
      in_configuration = section == "Configuration"
      if (in_configuration) {
        configuration_sections++
        if (configuration_sections > 1) malformed = 1
      }
      print
      next
    }
    {
      if (in_configuration) {
        key = parse_assignment($0)
        if (is_managed(key)) {
          if (current_found[key]) {
            malformed = 1
            next
          }
          current_found[key] = 1
          if (mode == "--sync") {
            print desired_line[key]
          } else if (parsed_value == desired_value[key]) {
            if (original_found[key]) print original_line[key]
          } else {
            print
          }
          next
        }
      }
      print
    }
    END {
      if (in_configuration) flush_missing()
      if (mode == "--sync" && configuration_sections == 0) {
        if (NR > 0) print ""
        print "[Configuration]"
        flush_missing()
      }
      if (malformed) {
        print "cambonos-branding: configuración terminalrc ambigua o plantilla incompleta; no se modificó." > "/dev/stderr"
        exit 1
      }
    }
  ' "$source" > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi

  if [[ -f "$CONFIG_FILE" ]]; then
    chmod --reference="$CONFIG_FILE" "$temporary"
  else
    chmod 644 "$temporary"
  fi

  if [[ -f "$CONFIG_FILE" ]] && cmp -s -- "$CONFIG_FILE" "$temporary"; then
    rm -f -- "$temporary"
  else
    mv -fT -- "$temporary" "$CONFIG_FILE"
  fi
}

save_original() {
  if [[ -e "$ORIGINAL_FILE" && -e "$ABSENT_MARKER" ]]; then
    report_error "el estado previo contiene marcadores incompatibles; no se modificará."
    return 1
  fi
  if [[ -e "$ORIGINAL_FILE" || -e "$ABSENT_MARKER" ]]; then
    return 0
  fi
  local -a state_entries
  shopt -s nullglob dotglob
  state_entries=("$STATE_DIR"/*)
  shopt -u nullglob dotglob
  if ((${#state_entries[@]})); then
    report_error "el estado de terminalrc está incompleto; no se modificará."
    return 1
  fi
  if [[ -f "$CONFIG_FILE" ]]; then
    cp -a -- "$CONFIG_FILE" "$ORIGINAL_FILE"
  else
    : > "$ABSENT_MARKER"
    chmod 600 "$ABSENT_MARKER"
  fi
}

sync_config() {
  [[ -f "$DEFAULTS_FILE" ]] || {
    report_error "falta la plantilla $DEFAULTS_FILE."
    return 1
  }
  validate_config_path || return 1
  if [[ -L "$STATE_DIR" || ( -e "$STATE_DIR" && ! -d "$STATE_DIR" ) ]]; then
    report_error "$STATE_DIR no es un directorio regular; no se modificará."
    return 1
  fi
  install -d -m700 -- "$STATE_DIR"
  mkdir -p -- "$CONFIG_DIR"
  save_original || return 1
  rewrite_config --sync || return 1
  rm -f -- "$MANAGED_FILE"
  cp -a -- "$CONFIG_FILE" "$MANAGED_FILE"
}

remove_config() {
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] || return 0
  if [[ -e "$ORIGINAL_FILE" && -e "$ABSENT_MARKER" ]] || \
     [[ ! -e "$ORIGINAL_FILE" && ! -e "$ABSENT_MARKER" ]]; then
    report_error "el estado previo de terminalrc está incompleto; se conserva para recuperación."
    return 1
  fi
  validate_config_path || return 1

  if [[ -f "$CONFIG_FILE" ]]; then
    if [[ -f "$MANAGED_FILE" ]] && cmp -s -- "$CONFIG_FILE" "$MANAGED_FILE"; then
      if [[ -f "$ORIGINAL_FILE" ]]; then
        local temporary
        temporary="$(mktemp "$CONFIG_DIR/.terminalrc.cambonos.XXXXXX")"
        cp -a -- "$ORIGINAL_FILE" "$temporary"
        mv -fT -- "$temporary" "$CONFIG_FILE"
      else
        rm -f -- "$CONFIG_FILE"
      fi
    else
      rewrite_config --remove || return 1
    fi
  elif [[ -f "$ORIGINAL_FILE" ]]; then
    mkdir -p -- "$CONFIG_DIR"
    cp -a -- "$ORIGINAL_FILE" "$CONFIG_FILE"
  fi

  rm -f -- "$ORIGINAL_FILE" "$ABSENT_MARKER" "$MANAGED_FILE"
  rmdir -- "$STATE_DIR"
}

if [[ "$action" == "--sync" ]] && pacman -Qq xfce4-terminal >/dev/null 2>&1; then
  sync_config
else
  remove_config
fi