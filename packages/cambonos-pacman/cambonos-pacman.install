#!/bin/bash

_manage_cambonos_pacman_config() {
  local action="$1"

  if ! /usr/lib/cambonos-pacman/manage-pacman-config "$action"; then
    echo "cambonos-pacman: no se pudo gestionar la integración en /etc/pacman.conf." >&2
    echo "cambonos-pacman: revisa los marcadores de configuración y corrige el conflicto manualmente." >&2
    return 1
  fi
}

post_install() {
  _manage_cambonos_pacman_config --ensure
}

post_upgrade() {
  _manage_cambonos_pacman_config --ensure
}

pre_remove() {
  _manage_cambonos_pacman_config --remove
}
