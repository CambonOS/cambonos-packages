#!/usr/bin/bash
# Manage CambonOS pacman option and repository Includes without replacing
# administrator-owned configuration. The optional path is for isolated tests.

set -Eeuo pipefail

readonly OPTIONS_START='# >>> cambonos-pacman: managed options'
readonly OPTIONS_END='# <<< cambonos-pacman: managed options'
readonly REPOS_START='# >>> cambonos-pacman: managed repositories'
readonly REPOS_END='# <<< cambonos-pacman: managed repositories'
readonly LEGACY_START='# >>> cambonos-repo: managed by cambonos-repo'
readonly LEGACY_END='# <<< cambonos-repo'
readonly OPTIONS_INCLUDE='Include = /etc/pacman.d/cambonos-options.conf'
readonly REPOS_INCLUDE='Include = /etc/pacman.d/cambonos.conf'
readonly OPTIONS_PATH='/etc/pacman.d/cambonos-options.conf'
readonly REPOS_PATH='/etc/pacman.d/cambonos.conf'

usage() {
  echo "Usage: $0 --ensure|--remove [pacman.conf-path]" >&2
  exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
action="$1"
config="${2:-/etc/pacman.conf}"
case "$action" in
  --ensure|--remove) ;;
  *) usage ;;
esac

if [[ ! -e "$config" ]]; then
  echo "cambonos-pacman: no existe $config; no se creará una configuración global." >&2
  exit 1
fi
if [[ -L "$config" || ! -f "$config" ]]; then
  echo "cambonos-pacman: $config no es un archivo regular; se cancela para evitar reemplazar una ruta especial." >&2
  exit 1
fi

stripped="$(mktemp "${config}.cambonos.XXXXXX")"
updated="$(mktemp "${config}.cambonos-updated.XXXXXX")"
options_updated="$(mktemp "${config}.cambonos-options.XXXXXX")"
state="$(mktemp "${config}.cambonos-state.XXXXXX")"
cleanup() { rm -f -- "$stripped" "$updated" "$options_updated" "$state"; }
trap cleanup EXIT

# Strip only complete CambonOS-managed blocks (including the old package's
# repository block). Record manual Includes outside those blocks.
if awk \
  -v options_start="$OPTIONS_START" -v options_end="$OPTIONS_END" \
  -v repos_start="$REPOS_START" -v repos_end="$REPOS_END" \
  -v legacy_start="$LEGACY_START" -v legacy_end="$LEGACY_END" \
  -v options_include="$OPTIONS_PATH" -v repos_include="$REPOS_PATH" \
  -v state_file="$state" '
  function section_name(line, value) {
    value = line
    sub(/^[[:space:]]*\[/, "", value)
    sub(/\].*$/, "", value)
    return value
  }
  BEGIN { inside = 0; current = ""; malformed = 0; options_sections = 0; manual_options = 0; manual_repos = 0 }
  $0 == options_start || $0 == repos_start || $0 == legacy_start {
    if (inside) malformed = 1
    inside = 1
    if ($0 == options_start) current = "options"
    else if ($0 == repos_start) current = "repos"
    else current = "legacy"
    starts[current]++
    next
  }
  $0 == options_end || $0 == repos_end || $0 == legacy_end {
    expected = ($0 == options_end ? "options" : ($0 == repos_end ? "repos" : "legacy"))
    if (!inside || current != expected) malformed = 1
    else ends[current]++
    inside = 0
    current = ""
    next
  }
  inside { next }
  {
    if ($0 ~ /^[[:space:]]*\[[^]]+\][[:space:]]*(#.*)?$/) {
      section = section_name($0)
      if (section == "options") options_sections++
    }
    if ($0 ~ /^[[:space:]]*Include[[:space:]]*=/) {
      value = $0
      sub(/^[[:space:]]*Include[[:space:]]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]+#.*$/, "", value)
      sub(/[[:space:]]+$/, "", value)
      if (section == "options" && value == options_include) manual_options = 1
      if (section != "options" && value == repos_include) manual_repos = 1
    }
    print
  }
  END {
    if (inside || malformed || starts["options"] != ends["options"] || starts["repos"] != ends["repos"] || starts["legacy"] != ends["legacy"]) exit 42
    printf "%d %d %d %d\n", options_sections, manual_options, manual_repos, starts["options"] + starts["repos"] + starts["legacy"] > state_file
  }
' "$config" > "$stripped"; then
  :
else
  status=$?
  if [[ "$status" -eq 42 ]]; then
    echo "cambonos-pacman: marcadores incompletos, duplicados anidados o desordenados en $config; no se ha modificado." >&2
  else
    echo "cambonos-pacman: error al procesar $config." >&2
  fi
  exit 1
fi

read -r options_sections manual_options manual_repos managed_blocks < "$state"

if [[ "$action" == "--remove" && "$managed_blocks" -eq 0 ]]; then
  exit 0
fi
if [[ "$action" == "--ensure" && "$managed_blocks" -eq 0 && "$manual_options" -eq 1 && "$manual_repos" -eq 1 ]]; then
  exit 0
fi

if [[ "$action" == "--remove" ]]; then
  cp -- "$stripped" "$updated"
else
  cp -- "$stripped" "$updated"

  if [[ "$manual_options" -eq 0 ]]; then
    if [[ "$options_sections" -ne 1 ]]; then
      echo "cambonos-pacman: se esperaba exactamente una sección [options] en $config; no se ha modificado." >&2
      exit 1
    fi

    awk \
      -v start="$OPTIONS_START" -v end="$OPTIONS_END" \
      -v include_line="$OPTIONS_INCLUDE" '
      function section_name(line, value) {
        value = line
        sub(/^[[:space:]]*\[/, "", value)
        sub(/\].*$/, "", value)
        return value
      }
      function insert_options() {
        print start
        print "# Opciones diferenciales de CambonOS; los valores predeterminados de Arch se omiten."
        print include_line
        print end
      }
      /^[[:space:]]*\[[^]]+\][[:space:]]*(#.*)?$/ {
        next_section = section_name($0)
        if (in_options && !inserted && next_section != "options") {
          insert_options()
          inserted = 1
        }
        if (next_section == "options") in_options = 1
        else if (in_options) in_options = 0
      }
      { print }
      END {
        if (in_options && !inserted) insert_options()
      }
    ' "$updated" > "$options_updated"
    mv -f -- "$options_updated" "$updated"
  fi

  if [[ "$manual_repos" -eq 0 ]]; then
    if [[ -s "$updated" ]]; then
      trailing_bytes="$(tail -c 2 "$updated" | od -An -t x1 | tr -d ' \n')"
      case "$trailing_bytes" in
        *0a) ;;
        *) printf '\n' >> "$updated" ;;
      esac
    fi
    printf '%s\n%s\n%s\n%s\n' \
      "$REPOS_START" \
      '# Gestionado por cambonos-pacman: desinstala el paquete para deshabilitar los repositorios.' \
      "$REPOS_INCLUDE" \
      "$REPOS_END" >> "$updated"
  fi
fi

if cmp -s -- "$config" "$updated"; then
  exit 0
fi
chmod --reference="$config" "$updated"
chown --reference="$config" "$updated"
mv -f -- "$updated" "$config"
echo "cambonos-pacman: configuración de $config actualizada."
