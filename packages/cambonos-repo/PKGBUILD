pkgname=cambonos-repo
pkgver=0.1.0
pkgrel=1
pkgdesc="CambonOS pacman repository configuration and integration"
arch=('any')
url="https://github.com/CambonOS/cambonos-packages"
license=('GPL-3.0-only')
depends=('bash' 'coreutils' 'gawk' 'cambonos-keyring')
backup=('etc/pacman.d/cambonos.conf')
install=cambonos-repo.install

package() {
  install -Dm644 "$startdir/files/cambonos.conf" \
    "$pkgdir/etc/pacman.d/cambonos.conf"
  install -Dm755 "$startdir/files/lib/manage-pacman-include" \
    "$pkgdir/usr/lib/cambonos-repo/manage-pacman-include"
  install -Dm644 "$startdir/files/hooks/cambonos-repo-pacman-conf.hook" \
    "$pkgdir/usr/share/libalpm/hooks/cambonos-repo-pacman-conf.hook"
}
