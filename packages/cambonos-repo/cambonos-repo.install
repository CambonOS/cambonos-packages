#!/bin/bash

_manage_cambonos_include() {
  local action="$1"

  if ! /usr/lib/cambonos-repo/manage-pacman-include "$action"; then
    echo "cambonos-repo: no se pudo gestionar la integración en /etc/pacman.conf." >&2
    echo "cambonos-repo: revisa los marcadores de configuración y corrige el conflicto manualmente." >&2
    return 1
  fi
}

post_install() {
  _manage_cambonos_include --ensure
}

post_upgrade() {
  _manage_cambonos_include --ensure
}

pre_remove() {
  _manage_cambonos_include --remove
}
