{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/cambonos/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    },
    "color": {
      "1": "black",
      "2": "green",
      "3": "white",
      "4": "blue"
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "green",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "cpu",
    "gpu",
    "cpuusage",
    "memory",
    "disk",
    "localip"
  ]
}
